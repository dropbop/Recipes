  "directions": [
    {
      "step": 1,
      "title": "Marinade",
      "text": "Blend all marinade ingredients together."
    },
    {
      "step": 2,
      "title": "Marinate",
      "text": "Marinate shrimp 2-4 hours, or chicken thighs 4-8 hours."
    },
    {
      "step": 3,
      "title": "Grill",
      "text": "Grill on skewers. Reserve the marinade."
    },
    {
      "step": 4,
      "title": "Sauce",
      "text": "Simmer the reserved marinade and use as a sauce."
    }
  ],
  "notes": [
    "Reserve the marinade after pulling the protein — simmer it and use as a sauce. It rocks.",
    "Don't pan sear — you'll burn the sugars and it's a pain to clean.",
    "For chicken, use thighs and marinate longer (4-8 hours).",
    "Works fine in the oven too."
