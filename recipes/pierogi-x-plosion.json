  "directions": [
    {
      "step": 1,
      "title": "Vegetables",
      "text": "Sauté peppers and onions seasoned with salt, pepper, garlic, and cayenne. Add a spoonful of hot water if they start to smoke or stick. When done, add to a baking dish."
    },
    {
      "step": 2,
      "title": "Kielbasa",
      "text": "Cook kielbasa in a pan until browned on the edges. Add to the baking dish."
    },
    {
      "step": 3,
      "title": "Pierogies",
      "text": "Boil pierogies for 2 minutes 30 seconds. Transfer to a sauté pan with butter, garlic, and cayenne. Cook until golden, then add to the baking dish."
    },
    {
      "step": 4,
      "title": "Assembly",
      "text": "Coat contents of baking dish with roughly half the cheddar and stir well."
    },
    {
      "step": 5,
      "title": "Sauce",
      "text": "Simmer chicken broth, dijon, cream cheese, and garlic until combined. Pour over the baking dish contents and stir until fully coated."
    },
    {
      "step": 6,
      "title": "Finish",
      "text": "Top with remaining cheddar. Broil until cheese is melted or golden brown."
    }
  ],
