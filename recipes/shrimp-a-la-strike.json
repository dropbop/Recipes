    {
      "step": 1,
      "title": "Build",
      "text": "Cut the Gruyère into french-fry-sized batons. Lay one against each shrimp and wrap the pair in a slice of prosciutto."
    },
    {
      "step": 2,
      "title": "Skewer",
      "text": "Run two parallel skewers through the whole row so everything actually stays in place."
    },
