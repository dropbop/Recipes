  "directions": [
    {
      "step": 1,
      "title": "Roast the Garlic",
      "text": "Oven to 400°F. Cut ¼ inch off the top of each head, set each on its own square of foil, drizzle with the 1 tbsp olive oil, and wrap. Roast until very soft, about 45 minutes. Leave the oven on. Let the garlic cool until you can handle it."
    },
    {
      "step": 2,
      "title": "Whip the Butter",
      "text": "Squeeze the garlic out of its skins into a bowl with the 8 tbsp butter, ¾ tsp salt, anchovy paste, and lemon zest. Whip with a hand mixer until light and fluffy."
    },
    {
      "step": 3,
      "title": "Stuff",
      "text": "Cut slits into the baguette about 1 inch apart, not all the way through. Set it on a sheet of foil and push at least a teaspoon of butter into every slit with an offset spatula or butter knife. Brush more over the top."
    },
    {
      "step": 4,
      "title": "Bake",
      "text": "Wrap it up in the foil and bake on a sheet pan for 15 minutes. Open the foil and bake another 5 minutes, until crisp. Serve immediately."
    }
  ],
